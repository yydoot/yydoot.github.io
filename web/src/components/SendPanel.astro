---
import FileCard from "./FileCard.astro";
---

<div class="send-column">
    <div id="dropzone" class="dropzone">
        <iconify-icon icon="mdi:tray-arrow-up" class="dropzone-icon"
        ></iconify-icon>
        <p class="dropzone-text">Drop files here or click to browse</p>
        <input id="file-input" type="file" multiple hidden />
    </div>

    <div class="files-section">
        <div id="empty-state" class="empty-state">
            <iconify-icon icon="mdi:folder-open-outline" class="empty-icon"
            ></iconify-icon>
            <p>No files selected to offer</p>
        </div>

        <div id="file-grid" class="file-grid" hidden></div>
    </div>

    <div id="send-action-bar" class="send-action-bar" hidden>
        <button id="btn-send" class="btn btn-primary">
            <iconify-icon icon="mdi:radar"></iconify-icon>
            <span id="btn-send-label">Offer</span>
        </button>
    </div>
</div>

<!-- Reusable FileCard template for send mode -->
<FileCard mode="send" />

<script>
    import { offerLocalFiles, cancelTransfer, iconForFile, formatSize } from "../js/file_transfer";

    const template = document.getElementById(
        "file-card-template",
    ) as HTMLTemplateElement | null;
    const fileGrid = document.getElementById("file-grid") as HTMLElement | null;
    const emptyState = document.getElementById(
        "empty-state",
    ) as HTMLElement | null;
    const dropzone = document.getElementById("dropzone") as HTMLElement | null;
    const fileInput = document.getElementById(
        "file-input",
    ) as HTMLInputElement | null;
    const sendActionBar = document.getElementById(
        "send-action-bar",
    ) as HTMLElement | null;
    const sendBtn = document.getElementById(
        "btn-send",
    ) as HTMLButtonElement | null;
    const sendLabel = document.getElementById(
        "btn-send-label",
    ) as HTMLElement | null;
    let files: File[] = [];

    function renderFiles(): void {
        if (!fileGrid || !sendBtn || !template || !emptyState || !sendLabel)
            return;

        const count = files.length;
        const hasFiles = count > 0;

        emptyState.hidden = hasFiles;
        fileGrid.hidden = !hasFiles;
        if (sendActionBar) sendActionBar.hidden = !hasFiles;
        // sendLabel.textContent = hasFiles
        //     ? `Offer (${count} ${count === 1 ? "file" : "files"})`
        //     : "Offer";

        if (!hasFiles) {
            fileGrid.replaceChildren();
            return;
        }

        const fragment = document.createDocumentFragment();

        files.forEach((f, i) => {
            const clone = template.content.cloneNode(true) as DocumentFragment;
            const root = clone.querySelector(
                ".file-card",
            ) as HTMLElement | null;
            const iconEls = clone.querySelectorAll(".file-icon");
            const nameEl = clone.querySelector(
                ".file-name",
            ) as HTMLElement | null;
            const typePill = clone.querySelector(
                ".file-type-pill",
            ) as HTMLElement | null;
            const sizeEl = clone.querySelector(
                ".file-size",
            ) as HTMLElement | null;
            const removeBtns = clone.querySelectorAll(".file-remove");
            const cancelBtns = clone.querySelectorAll(".file-cancel-btn");

            if (root) root.dataset.fileName = f.name;
            const ext = f.name.split(".").pop()?.toUpperCase() || "FILE";
            const iconName = iconForFile(f.name);

            iconEls.forEach((iconEl) => iconEl.setAttribute("icon", iconName));
            if (nameEl) {
                nameEl.textContent = f.name;
                nameEl.setAttribute("title", f.name);
            }
            if (typePill) typePill.textContent = ext;
            if (sizeEl) sizeEl.textContent = formatSize(f.size);
            removeBtns.forEach(
                (btn) => ((btn as HTMLElement).dataset.index = String(i)),
            );

            cancelBtns.forEach((btn) => {
                btn.addEventListener("click", () => {
                    const fileId = root?.dataset.fileId;
                    if (fileId) cancelTransfer(fileId);
                    // Reset card action
                    const progressWraps = root?.querySelectorAll(
                        ".progress-action-wrap",
                    );
                    const rBtns = root?.querySelectorAll(".file-remove");
                    progressWraps?.forEach(
                        (w) => ((w as HTMLElement).hidden = true),
                    );
                    rBtns?.forEach((b) => ((b as HTMLElement).hidden = false));
                });
            });

            fragment.appendChild(clone);
        });

        fileGrid.replaceChildren(fragment);
    }

    export function updateSenderProgressBar(progress: any): void {
        const cards = Array.from(
            document.querySelectorAll<HTMLElement>(".send-column .file-card"),
        );
        const targetCard = cards.find(
            (cardEl) => cardEl.dataset.fileName === progress.filename,
        );

        if (!targetCard) return;
        targetCard.dataset.fileId = progress.fileId;

        const removeBtns = targetCard.querySelectorAll(".file-remove");
        const progressWraps = targetCard.querySelectorAll(
            ".progress-action-wrap",
        );
        const circleFills = targetCard.querySelectorAll(".circle-fill");

        removeBtns.forEach((btn) => ((btn as HTMLElement).hidden = true));
        progressWraps.forEach((wrap) => ((wrap as HTMLElement).hidden = false));

        const circumference = 94.25; // 2 * pi * 15
        const pct = Math.min(1, Math.max(0, progress.progress));

        circleFills.forEach((fill) => {
            (fill as SVGElement).setAttribute(
                "stroke-dasharray",
                `${(pct * circumference).toFixed(1)}, ${circumference}`,
            );
        });

        if (pct >= 1) {
            progressWraps.forEach(
                (wrap) => ((wrap as HTMLElement).hidden = true),
            );
            removeBtns.forEach((btn) => ((btn as HTMLElement).hidden = false));
        }
    }

    (window as any).__dootSend = {
        updateSenderProgressBar,
    };

    function addFiles(fileArray: FileList | File[] | null | undefined): void {
        if (!fileArray) return;
        const newFiles = Array.from(fileArray);
        files = files.concat(newFiles);
        renderFiles();
    }

    dropzone?.addEventListener("click", () => fileInput?.click());
    fileInput?.addEventListener("change", (e) => {
        const target = e.target as HTMLInputElement;
        addFiles(target.files);
    });

    ["dragover", "dragenter"].forEach((evt) =>
        dropzone?.addEventListener(evt, (e) => {
            e.preventDefault();
            dropzone.classList.add("drag-active");
        }),
    );
    ["dragleave", "drop"].forEach((evt) =>
        dropzone?.addEventListener(evt, (e) => {
            e.preventDefault();
            dropzone.classList.remove("drag-active");
        }),
    );
    dropzone?.addEventListener("drop", (e) => {
        const dragEvent = e as DragEvent;
        addFiles(dragEvent.dataTransfer?.files);
    });

    fileGrid?.addEventListener("click", (e) => {
        const target = e.target as HTMLElement | null;
        const btn = target?.closest(".file-remove") as HTMLElement | null;
        if (!btn || !btn.dataset.index) return;
        files.splice(Number(btn.dataset.index), 1);
        renderFiles();
    });

    sendBtn?.addEventListener("click", () => {
        if (files.length > 0) {
            offerLocalFiles(files);
        }
    });

    renderFiles();
</script>

<style>
    .send-column {
        display: flex;
        flex-direction: column;
        gap: 16px;
        min-height: 0;
        flex: 1;
    }

    /* 1. Standalone Dropzone */
    .dropzone {
        border: 1.5px dashed var(--border-focus);
        border-radius: 10px;
        padding: 32px 24px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        background-color: transparent;
        transition:
            border-color 0.15s ease,
            background-color 0.15s ease;
    }

    .dropzone:hover,
    .dropzone.drag-active {
        border-color: var(--border-focus);
        background-color: var(--bg-surface);
    }

    .dropzone-icon {
        font-size: 26px;
        width: 26px;
        height: 26px;
        color: var(--text-muted);
        transition: color 0.15s ease;
    }

    .dropzone-text {
        font-size: 13px;
        color: var(--text-muted);
        transition: color 0.15s ease;
    }

    /* 2. Files Section & Grid Layout */
    .files-section {
        display: flex;
        flex-direction: column;
    }

    .empty-state {
        min-height: 160px;
        border-radius: 10px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: var(--text-muted);
        font-size: 13px;
        background-color: var(--bg-surface);
        box-shadow: var(--shadow-sm);
    }

    .empty-icon {
        font-size: 28px;
        width: 28px;
        height: 28px;
        opacity: 0.6;
    }

    .file-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 12px;
        max-height: 380px;
        overflow-y: auto;
        padding-right: 2px;
    }

    @media (max-width: 720px) {
        .file-grid {
            display: flex;
            flex-direction: column;
            gap: 8px;
            max-height: none;
            overflow-y: visible;
        }
    }

    .send-action-bar {
        margin-top: 4px;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        width: 100%;
        padding: 13px 18px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        border: none;
        transition:
            background-color 0.15s ease,
            opacity 0.15s ease;
    }

    .btn-primary {
        background-color: var(--accent-primary);
        color: var(--text-on-accent);
    }
    .btn-primary:hover:not(:disabled) {
        background-color: var(--accent-primary-hover);
    }
    .btn-primary:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }
</style>
