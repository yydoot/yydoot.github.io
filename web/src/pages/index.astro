---
import Layout from "../layouts/Layout.astro";
import DootLogo from "../components/DootLogo.astro";
import UserBadge from "../components/UserBadge.astro";
---

<Layout>
	<div class="app-container">
		<header class="header">
			<a href="/" class="brand">
				<DootLogo size={56} />
				<span class="brand-name">doot</span>
			</a>
			<UserBadge />
		</header>

		<main class="main-content">
			<div class="hero-section">
				<h1 class="hero-title">Join a Room</h1>
			</div>

			<!-- Tab Navigation matching room.astro and proxy.astro style -->
			<div class="tab-nav">
				<span class="tab-nav-label mono-font">Select type:</span>
				<div class="tab-nav-buttons">
					<button
						id="tab-btn-file"
						type="button"
						class="tab-btn active"
					>
						<span>File Transfer</span>
					</button>
					<button id="tab-btn-proxy" type="button" class="tab-btn">
						<span>HTTP Proxy</span>
					</button>
				</div>
			</div>

			<section class="join-card">
				<form
					id="join-form"
					class="action-form"
					action="/room"
					method="GET"
				>
					<div class="input-group">
						<label for="room-input" class="input-label"
							>ROOM NAME</label
						>
						<input
							id="room-input"
							name="name"
							type="text"
							placeholder="eg. dodo"
							class="text-input mono-font"
							spellcheck="false"
							autocomplete="off"
							required
						/>
					</div>

					<button
						id="btn-enter"
						type="submit"
						class="btn btn-primary"
					>
						Enter Room
					</button>
				</form>
			</section>
		</main>
	</div>
</Layout>

<script>
	const joinForm = document.getElementById(
		"join-form",
	) as HTMLFormElement | null;
	const roomInput = document.getElementById(
		"room-input",
	) as HTMLInputElement | null;
	const tabBtnFile = document.getElementById("tab-btn-file");
	const tabBtnProxy = document.getElementById("tab-btn-proxy");

	roomInput?.addEventListener("input", () => {
		if (roomInput.value) {
			const start = roomInput.selectionStart;
			const end = roomInput.selectionEnd;
			roomInput.value = roomInput.value.toLowerCase();
			if (start !== null && end !== null) {
				roomInput.setSelectionRange(start, end);
			}
		}
	});

	joinForm?.addEventListener("submit", () => {
		if (roomInput) {
			roomInput.value = roomInput.value.trim().toLowerCase();
		}
	});

	tabBtnFile?.addEventListener("click", () => {
		if (joinForm) joinForm.action = "/room";
		tabBtnFile.classList.add("active");
		tabBtnProxy?.classList.remove("active");
	});

	tabBtnProxy?.addEventListener("click", () => {
		if (joinForm) joinForm.action = "/proxy";
		tabBtnProxy.classList.add("active");
		tabBtnFile?.classList.remove("active");
	});
</script>

<style>
	.app-container {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		max-width: 880px;
		margin: 0 auto;
		padding: 24px 20px;
	}

	.main-content {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		padding: 56px 0;
	}

	.hero-section {
		margin-bottom: 36px;
		text-align: center;
	}

	.hero-title {
		font-size: 34px;
		font-weight: 800;
		letter-spacing: -0.03em;
	}

	.hero-subtitle {
		font-size: 15px;
		color: var(--text-secondary);
		max-width: 420px;
		margin: 0 auto;
	}

	.join-card {
		width: 100%;
		max-width: 420px;
		background-color: var(--bg-surface);
		border: 1px solid var(--border-subtle);
		border-radius: 10px;
		padding: 26px;
	}

	@media (max-width: 600px) {
		.join-card {
			padding: 20px;
		}
	}

	.action-form {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.input-group {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.input-label {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.05em;
		color: var(--text-muted);
		font-family: var(--font-mono);
	}

	.text-input {
		width: 100%;
		background-color: var(--bg-input);
		border: 1px solid var(--border-subtle);
		border-radius: 8px;
		padding: 12px 14px;
		color: var(--text-primary);
		font-size: 14px;
		outline: none;
		transition: border-color 0.15s ease;
	}

	.text-input:focus {
		border-color: var(--accent-primary);
	}

	/* Tab Navigation matching room.astro and proxy.astro */
	.tab-nav {
		display: flex;
		align-items: center;
		padding: 4px 0;
		gap: 12px;
		width: 100%;
		max-width: 420px;
		margin-bottom: 1rem;
	}

	.tab-nav-label {
		font-size: 13px;
		font-weight: 500;
		color: var(--text-muted);
		letter-spacing: -0.01em;
	}

	.tab-nav-buttons {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.tab-btn {
		border-radius: 6px;
		font-size: 14px;
		font-weight: 600;
		padding: 4px 6px;
		color: var(--text-secondary);
		background: transparent;
		border: none;
		cursor: pointer;
		transition:
			color 0.15s ease,
			background-color 0.15s ease;
	}

	.tab-btn:hover {
		color: var(--text-primary);
	}

	.tab-btn.active {
		text-decoration: underline;
		text-underline-offset: 4px;
		color: var(--accent-text);
	}

	.mono-font {
		font-family: var(--font-mono);
	}

	.btn {
		width: 100%;
		padding: 13px 18px;
		border-radius: 8px;
		font-size: 14px;
		font-weight: 600;
		cursor: pointer;
		border: none;
	}

	.btn-primary {
		background-color: var(--accent-primary);
		color: var(--text-on-accent);
	}

	.btn-primary:hover {
		background-color: var(--accent-primary-hover);
	}
</style>
