---
import Layout from "../layouts/Layout.astro";
import DootLogo from "../components/DootLogo.astro";
---

<Layout>
    <div class="proxy-page">
        <!-- Minimal Header matching doot style -->
        <header class="header">
            <a href="/" class="brand">
                <DootLogo size={44} />
                <span class="brand-name">doot</span>
            </a>

            <div class="header-right">
                <div class="room-indicator mono-font">
                    <span id="room-label">room:</span>
                    <strong id="room-id">—</strong>
                </div>
            </div>
        </header>

        <!-- Tab Navigation matching room.astro style -->
        <div class="tab-nav">
            <button id="tab-btn-host" type="button" class="tab-btn active">
                <span>Host</span>
            </button>
            <button id="tab-btn-client" type="button" class="tab-btn">
                <span>Client</span>
            </button>
        </div>

        <!-- Main Content Panes -->
        <main class="proxy-content">
            <!-- Host Panel -->
            <div id="tab-pane-host" class="tab-pane">
                <div class="mobile-peer">
                    <p id="host-mobile-peer-label" class="mobile-peer-label">
                        no clients connected
                    </p>
                </div>

                <!-- Dedicated Share Client Link Card (Single-line) -->
                <div class="card host-share-card host-share-card-single">
                    <span class="card-tag mono-font">CLIENT LINK</span>
                    <input
                        id="host-client-url-input"
                        type="text"
                        readonly
                        class="input mono-font host-share-input"
                    />
                    <button
                        id="host-copy-client-url-btn"
                        type="button"
                        class="btn btn-secondary host-share-btn"
                    >
                        Copy
                    </button>
                </div>

                <div class="proxy-layout">
                    <div class="proxy-main-col">
                        <div class="card">
                            <div class="field-group">
                                <div class="field-header">
                                    <label for="host-target-input" class="label"
                                        >LOCAL SERVER ADDRESS</label
                                    >
                                    <div class="target-health-controls">
                                        <span
                                            id="target-health-badge"
                                            class="target-health-badge mono-font"
                                            style="display: none;"></span>
                                        <button
                                            id="btn-retry-health"
                                            type="button"
                                            class="btn-retry-health"
                                            title="Recheck local server connection"
                                        >
                                            <iconify-icon icon="mdi:refresh"></iconify-icon>
                                            <span>Retry</span>
                                        </button>
                                    </div>
                                </div>
                                <input
                                    id="host-target-input"
                                    type="text"
                                    value="http://localhost:4321"
                                    class="input mono-font"
                                    placeholder="http://localhost:4322"
                                />
                                <div
                                    id="target-health-alert"
                                    class="target-health-alert"
                                    style="display: none;"
                                >
                                </div>
                            </div>
                        </div>
                    </div>

                    <aside class="peer-panel host-peer-panel">
                        <h2 class="panel-title">Connected Clients</h2>
                        <div class="client-count-wrapper">
                            <span
                                id="host-peer-name"
                                class="client-count-number">0</span
                            >
                        </div>
                    </aside>
                </div>

                <!-- Host Request Log (Last 50 requests) -->
                <div class="log-section">
                    <div class="log-header">
                        <span class="log-title mono-font">REQUESTS</span>
                        <button
                            id="clear-logs-btn"
                            type="button"
                            class="btn-clear mono-font">Clear</button
                        >
                    </div>
                    <div class="log-grid-container">
                        <div id="log-empty" class="log-empty">
                            No requests forwarded yet
                        </div>
                        <div
                            id="log-grid"
                            class="log-grid"
                            style="display: none;"
                        >
                            <div class="log-grid-header">
                                <div class="col-id">#</div>
                                <div class="col-status">STATUS</div>
                                <div class="col-method">METHOD</div>
                                <div class="col-path">PATH</div>
                                <div class="col-time">TIME</div>
                            </div>
                            <div id="log-rows" class="log-rows"></div>
                        </div>

                        <!-- Template for log row -->
                        <template id="log-row-template">
                            <div class="log-grid-row">
                                <div class="col-id"></div>
                                <div class="col-status"></div>
                                <div class="col-method"></div>
                                <div class="col-path"></div>
                                <div class="col-time"></div>
                            </div>
                        </template>
                    </div>
                </div>
            </div>

            <!-- Client Panel -->
            <div id="tab-pane-client" class="tab-pane" hidden>
                <div class="client-layout-full">
                    <!-- Available Hosts List -->
                    <div class="card hosts-section-card">
                        <div class="card-title-row">
                            <span
                                id="hosts-header-title"
                                class="card-tag mono-font"
                                >0 AVAILABLE HOSTS</span
                            >
                        </div>
                        <p class="hosts-section-desc">
                            Click on any host to connect and open the tunneled
                            application in a new tab.
                        </p>

                        <!-- Host Selection List -->
                        <div id="hosts-list" class="hosts-list">
                            <div id="hosts-empty" class="hosts-empty">
                                <iconify-icon
                                    icon="mdi:server-network-off"
                                    class="empty-icon"></iconify-icon>
                                <p>No hosts online in this room yet.</p>
                                <span class="empty-sub"
                                    >When someone opens the Host tab, they will
                                    appear here.</span
                                >
                            </div>
                            <div
                                id="hosts-container"
                                class="hosts-container"
                                style="display: none;"
                            >
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</Layout>

<script>
    import {
        Peers,
        setRole,
        PEER_ID,
        selectedHostPeerId,
        selectHost,
    } from "../js/peers";
    import { SS } from "../js/signaling";
    import { handleClientProxyRequest } from "../js/proxy/client";
    import { setTargetHost, RequestLogs } from "../js/proxy/host";
    import { getStoredUsername } from "../js/username";

    const search = window.location.search;
    const params = new URLSearchParams(search);
    const roomParam = params.get("name") || params.get("room");
    const rawParam = search.startsWith("?") ? search.slice(1).trim() : "";
    const fallbackParam =
        rawParam && !rawParam.includes("=") ? decodeURIComponent(rawParam) : "";
    const roomName = roomParam || fallbackParam || "proxy-room";

    const roomIdEl = document.getElementById("room-id");
    if (roomIdEl) roomIdEl.textContent = roomName;

    let currentUsername = getStoredUsername();

    // Mode: Default is always 'client'. A client chooses to become a 'proxy' (host).
    let mode: "proxy" | "client" =
        params.get("mode") === "proxy" || params.get("role") === "proxy"
            ? "proxy"
            : "client";

    // Join room with initial role and username metadata
    setRole(mode);
    SS.joinRoom(roomName, { role: mode, username: currentUsername });

    window.addEventListener("doot:username-changed", (e: any) => {
        currentUsername = e.detail;
        SS.sendSignal({
            type: "update_metadata",
            room_id: roomName,
            metadata: { role: mode, username: currentUsername },
        });
    });

    // Elements
    const tabBtnHost = document.getElementById("tab-btn-host");
    const tabBtnClient = document.getElementById("tab-btn-client");
    const tabPaneHost = document.getElementById("tab-pane-host");
    const tabPaneClient = document.getElementById("tab-pane-client");
    const hostTargetInput = document.getElementById(
        "host-target-input",
    ) as HTMLInputElement | null;
    const hostClientUrlInput = document.getElementById(
        "host-client-url-input",
    ) as HTMLInputElement | null;
    const hostCopyClientUrlBtn = document.getElementById(
        "host-copy-client-url-btn",
    );
    const hostPeerName = document.getElementById("host-peer-name");
    const hostMobilePeerLabel = document.getElementById(
        "host-mobile-peer-label",
    );

    // Host-side client share link: direct link for clients to join this exact room in client mode
    const clientJoinUrl = `${window.location.origin}/proxy?name=${encodeURIComponent(roomName)}&mode=client`;
    if (hostClientUrlInput) hostClientUrlInput.value = clientJoinUrl;
    hostCopyClientUrlBtn?.addEventListener("click", () => {
        if (hostClientUrlInput) {
            navigator.clipboard.writeText(hostClientUrlInput.value);
            hostCopyClientUrlBtn.textContent = "Copied";
            setTimeout(() => {
                hostCopyClientUrlBtn.textContent = "Copy";
            }, 1500);
        }
    });

    // Tunnel param: ?__tunnel=<roomId>
    const tunnelUrl = `${window.location.origin}?__tunnel=${encodeURIComponent(roomName)}`;

    function updateMode(newMode: "proxy" | "client") {
        mode = newMode;
        setRole(mode);
        SS.sendSignal({
            type: "update_metadata",
            room_id: roomName,
            metadata: { role: mode, username: currentUsername },
        });

        // Store tab state in URL so reloading opens the correct tab!
        const curUrl = new URL(window.location.href);
        curUrl.searchParams.set("mode", mode);
        window.history.replaceState(null, "", curUrl.toString());

        const isHost = mode === "proxy";
        tabBtnHost?.classList.toggle("active", isHost);
        tabBtnClient?.classList.toggle("active", !isHost);

        if (tabPaneHost) tabPaneHost.hidden = !isHost;
        if (tabPaneClient) tabPaneClient.hidden = isHost;
    }

    updateMode(mode);

    tabBtnHost?.addEventListener("click", () => updateMode("proxy"));
    tabBtnClient?.addEventListener("click", () => updateMode("client"));

    // Host Request Logs (Store & display last 50)
    const logGrid = document.getElementById("log-grid");
    const logRows = document.getElementById("log-rows");
    const logEmpty = document.getElementById("log-empty");
    const clearLogsBtn = document.getElementById("clear-logs-btn");

    const logRowTemplate = document.getElementById(
        "log-row-template",
    ) as HTMLTemplateElement | null;

    clearLogsBtn?.addEventListener("click", () => {
        RequestLogs.clear();
    });

    RequestLogs.onchange((entries) => {
        if (!entries || entries.length === 0) {
            if (logGrid) logGrid.style.display = "none";
            if (logEmpty) logEmpty.style.display = "block";
            if (logRows) logRows.innerHTML = "";
            return;
        }

        if (logEmpty) logEmpty.style.display = "none";
        if (logGrid) logGrid.style.display = "flex";

        if (logRows && logRowTemplate) {
            logRows.innerHTML = "";
            const fragment = document.createDocumentFragment();

            for (const entry of entries) {
                const clone = logRowTemplate.content.cloneNode(
                    true,
                ) as DocumentFragment;
                const row = clone.querySelector(".log-grid-row");
                const colId = clone.querySelector(".col-id");
                const colStatus = clone.querySelector(".col-status");
                const colMethod = clone.querySelector(".col-method");
                const colPath = clone.querySelector(
                    ".col-path",
                ) as HTMLElement | null;
                const colTime = clone.querySelector(".col-time");

                const is2xx = entry.status >= 200 && entry.status < 300;
                const is3xx = entry.status >= 300 && entry.status < 400;
                const is4xx = entry.status >= 400 && entry.status < 500;
                const statusColorClass = is2xx
                    ? "status-2xx"
                    : is3xx
                      ? "status-3xx"
                      : is4xx
                        ? "status-4xx"
                        : "status-5xx";

                if (colId) colId.textContent = String(entry.id);
                if (colStatus) {
                    colStatus.textContent = String(entry.status);
                    colStatus.classList.add(statusColorClass);
                }
                if (colMethod) colMethod.textContent = entry.method;
                if (colPath) {
                    colPath.textContent = entry.path;
                    colPath.title = entry.path;
                }
                if (colTime) colTime.textContent = `${entry.durationMs}ms`;

                fragment.appendChild(clone);
            }

            logRows.appendChild(fragment);
        }
    });

    // Host target input setup, sync & proactive health probe
    const targetHealthBadge = document.getElementById("target-health-badge");
    const targetHealthAlert = document.getElementById("target-health-alert");
    let healthCheckTimer: number | undefined;

    async function checkTargetHealth(rawHost: string) {
        if (!targetHealthBadge || !targetHealthAlert) return;
        const host = rawHost.trim().replace(/\/+$/, "");
        if (!host) {
            targetHealthBadge.style.display = "none";
            targetHealthAlert.style.display = "none";
            return;
        }

        targetHealthBadge.style.display = "inline-flex";
        targetHealthBadge.className = "target-health-badge checking mono-font";
        targetHealthBadge.textContent = "Checking...";
        targetHealthAlert.style.display = "none";

        try {
            // Probe with CORS request from the browser
            const res = await fetch(`${host}/`, {
                method: "GET",
                signal: AbortSignal.timeout(3500),
            });

            targetHealthBadge.className =
                "target-health-badge healthy mono-font";
            targetHealthBadge.textContent = `Online`;
            targetHealthAlert.style.display = "none";
        } catch (err: any) {
            // In browser fetch, TypeError: Failed to fetch occurs for either:
            // 1. Connection refused / service not running
            // 2. CORS / Private Network Access headers blocked
            // Probe via no-cors to differentiate:
            try {
                await fetch(`${host}/`, {
                    mode: "no-cors",
                    signal: AbortSignal.timeout(2000),
                });

                // Server responded (opaque), meaning server IS running but CORS blocked the host browser tab!
                targetHealthBadge.className =
                    "target-health-badge warning mono-font";
                targetHealthBadge.textContent = "CORS Missing";
                targetHealthAlert.className = "target-health-alert warning";
                targetHealthAlert.style.display = "block";
                targetHealthAlert.innerHTML = `
                    <strong>Server running, but CORS headers are missing:</strong><br />
                    Add <code>Access-Control-Allow-Origin: *</code> (or <code>${window.location.origin}</code>) and <code>Access-Control-Allow-Private-Network: true</code> to your local server so this browser tab can forward requests.
                `;
            } catch {
                // Completely unreachable / port closed / connection refused
                targetHealthBadge.className =
                    "target-health-badge unreachable mono-font";
                targetHealthBadge.textContent = "Unreachable";
                targetHealthAlert.className = "target-health-alert unreachable";
                targetHealthAlert.style.display = "block";
                targetHealthAlert.innerHTML = `
                    <strong>Service not running or refused connection on <code>${host}</code>:</strong><br />
                    Ensure your local dev server is started and listening on this port.
                `;
            }
        }
    }

    const syncHostTarget = () => {
        if (hostTargetInput?.value) {
            const host = hostTargetInput.value.trim();
            setTargetHost(host);
            window.clearTimeout(healthCheckTimer);
            healthCheckTimer = window.setTimeout(() => {
                checkTargetHealth(host);
            }, 350);
        }
    };

    if (hostTargetInput?.value) {
        setTargetHost(hostTargetInput.value.trim());
        checkTargetHealth(hostTargetInput.value.trim());
    }

    hostTargetInput?.addEventListener("input", syncHostTarget);
    hostTargetInput?.addEventListener("change", syncHostTarget);

    const btnRetryHealth = document.getElementById("btn-retry-health");
    btnRetryHealth?.addEventListener("click", async () => {
        if (hostTargetInput?.value) {
            btnRetryHealth.classList.add("spinning");
            await checkTargetHealth(hostTargetInput.value.trim());
            btnRetryHealth.classList.remove("spinning");
        }
    });

    // Broadcast channel to notify waiting tunnel tabs reactively
    const tunnelChannel =
        "BroadcastChannel" in window
            ? new BroadcastChannel("doot_tunnel")
            : null;

    // Client Host Selection Elements
    const hostsEmpty = document.getElementById("hosts-empty");
    const hostsContainer = document.getElementById("hosts-container");
    const hostsHeaderTitle = document.getElementById("hosts-header-title");

    function renderHostsList() {
        const availableHosts = Array.from(Peers.map.values()).filter(
            (peer) => peer.id !== PEER_ID && peer.role === "proxy",
        );

        if (hostsHeaderTitle) {
            const count = availableHosts.length;
            hostsHeaderTitle.textContent = `${count} AVAILABLE ${count === 1 ? "HOST" : "HOSTS"}`;
        }

        if (availableHosts.length === 0) {
            if (hostsEmpty) hostsEmpty.style.display = "flex";
            if (hostsContainer) hostsContainer.style.display = "none";
            return;
        }

        if (hostsEmpty) hostsEmpty.style.display = "none";
        if (hostsContainer) {
            hostsContainer.style.display = "flex";
            const newHtml = availableHosts
                .map((peer) => {
                    const peerId = peer.id;
                    const isSelected = selectedHostPeerId === peerId;
                    const isConnected =
                        peer.conn?.connectionState === "connected";
                    const isConnecting =
                        isSelected &&
                        peer.conn?.connectionState === "connecting";
                    const displayName =
                        peer.username || `Host-${peerId.slice(0, 6)}`;
                    const shortId = peerId.slice(0, 8);

                    let statusBadgeHtml = "";
                    if (isConnected) {
                        statusBadgeHtml = `<span class="badge-connect connected mono-font">Connected</span>`;
                    } else if (isConnecting) {
                        statusBadgeHtml = `<span class="badge-connect connecting mono-font">Connecting...</span>`;
                    }

                    return `
                        <div class="host-card ${isSelected ? "selected" : ""}" data-peer-id="${peerId}" role="button" tabindex="0" title="Click to connect with ${displayName} and open tunneled app">
                            <div class="host-card-info">
                                <span class="host-card-icon">
                                    <iconify-icon icon="mdi:server-network"></iconify-icon>
                                </span>
                                <div class="host-card-details">
                                    <span class="host-card-name">${displayName}</span>
                                    <div class="host-card-meta-row">
                                        <span class="host-card-meta mono-font">${shortId}</span>
                                        ${statusBadgeHtml}
                                    </div>
                                </div>
                            </div>
                            <div class="host-card-action">
                                <iconify-icon icon="mdi:open-in-new" class="host-open-icon"></iconify-icon>
                            </div>
                        </div>
                    `;
                })
                .join("");

            if (hostsContainer.innerHTML !== newHtml) {
                hostsContainer.innerHTML = newHtml;

                // When user clicks the host card, select the host and open the tunnel tab
                hostsContainer.querySelectorAll(".host-card").forEach((card) => {
                    const clickHandler = () => {
                        const targetId = (card as HTMLElement).dataset.peerId;
                        if (targetId) {
                            selectHost(targetId);
                            window.open(tunnelUrl, "_blank");
                            renderHostsList();
                        }
                    };

                    card.addEventListener("click", clickHandler);
                    card.addEventListener("keydown", (e: any) => {
                        if (e.key === "Enter" || e.key === " ") {
                            e.preventDefault();
                            clickHandler();
                        }
                    });
                });
            }
        }
    }

    // Helper to update host peer UI
    function updateHostPeerUI(count: number) {
        if (hostPeerName) hostPeerName.textContent = String(count);
        if (hostMobilePeerLabel) {
            if (count > 0) {
                hostMobilePeerLabel.innerHTML = `<span style="color: var(--text-primary); margin-right: 5px;">Connected Clients</span> <span class="peer-id-val">${count}</span>`;
            } else {
                hostMobilePeerLabel.textContent = "0 clients connected";
            }
        }
    }

    // Subscribe to unified Peers changes (one single listener handles everything!)
    Peers.onchange((map) => {
        // 1. Host side: show number of clients connected
        const connectedClients = Array.from(map.values()).filter(
            (peer) =>
                peer.id !== PEER_ID &&
                peer.conn?.connectionState === "connected" &&
                peer.role !== "proxy",
        );
        updateHostPeerUI(connectedClients.length);

        // 2. Client side: re-render host cards with updated connection states & usernames
        renderHostsList();

        // ONLY broadcast ready when there is an active CONNECTED WebRTC connection!
        const hasConnectedPeer = Array.from(map.values()).some(
            (p) => p.conn?.connectionState === "connected",
        );
        if (hasConnectedPeer && tunnelChannel) {
            tunnelChannel.postMessage({ type: "ready", roomId: roomName });
        }
    });

    // Track active tunnel tabs; when 0 tabs are open, disconnect WebRTC host
    let activeTunnelTabsCount = 0;
    if (tunnelChannel) {
        tunnelChannel.onmessage = (e) => {
            if (e.data?.roomId && e.data.roomId !== roomName) return;

            if (e.data?.type === "TAB_OPENED") {
                activeTunnelTabsCount++;
            } else if (e.data?.type === "TAB_CLOSED") {
                activeTunnelTabsCount = Math.max(0, activeTunnelTabsCount - 1);
                if (activeTunnelTabsCount === 0) {
                    console.log("[Hub] All tunnel tabs closed. Disconnecting WebRTC peer...");
                    selectHost(null);
                    renderHostsList();
                }
            }
        };
    }

    window.addEventListener("beforeunload", () => {
        if (tunnelChannel) {
            tunnelChannel.postMessage({ type: "HUB_CLOSED", roomId: roomName });
        }
    });

    // Helper: wait for a connected peer if ICE negotiation is currently finishing
    async function waitForConnectedPeer(
        targetPeerId: string | null,
        timeoutMs = 2500,
    ): Promise<boolean> {
        const check = () => {
            if (targetPeerId) {
                const p = Peers.map.get(targetPeerId);
                return p?.conn?.connectionState === "connected";
            }
            return Array.from(Peers.map.values()).some(
                (p) => p.conn?.connectionState === "connected",
            );
        };
        if (check()) return true;

        return new Promise((resolve) => {
            const timer = setTimeout(() => {
                cleanup();
                resolve(check());
            }, timeoutMs);

            const cleanup = Peers.onchange(() => {
                if (check()) {
                    clearTimeout(timer);
                    cleanup();
                    resolve(true);
                }
            });
        });
    }

    // Dispatch request to connected peer (prioritize selected host)
    function dispatchProxyRequest(
        head: ArrayBuffer,
        port: MessagePort,
        hasBody: boolean,
    ): boolean {
        if (selectedHostPeerId) {
            const peer = Peers.map.get(selectedHostPeerId);
            if (peer?.conn?.connectionState === "connected") {
                handleClientProxyRequest(peer.conn, head, port, hasBody);
                return true;
            }
        }
        for (const [id, peer] of Peers.map) {
            if (peer.conn?.connectionState === "connected") {
                handleClientProxyRequest(peer.conn, head, port, hasBody);
                return true;
            }
        }
        return false;
    }

    async function handleProxyRequestMessage(
        data: any,
        ports: readonly MessagePort[],
    ) {
        if (data?.type === "PROXY_REQUEST_START") {
            const { head, hasBody } = data;
            const reqPort = ports[0];
            if (head && reqPort) {
                // If peer is still negotiating (ICE handshake), give it up to 2.5s to finish
                let sent = dispatchProxyRequest(head, reqPort, hasBody);
                if (!sent) {
                    const isReady = await waitForConnectedPeer(
                        selectedHostPeerId,
                        2500,
                    );
                    if (isReady) {
                        sent = dispatchProxyRequest(head, reqPort, hasBody);
                    }
                }

                if (!sent) {
                    console.warn(
                        "[Hub] No connected WebRTC peer! Sending RESPONSE_ERROR",
                    );
                    reqPort.postMessage({ type: "RESPONSE_ERROR" });
                    reqPort.close();
                }
            }
        }
    }

    // Register Service Worker and listen for tunnel requests directly
    async function initServiceWorkerListener() {
        if (!("serviceWorker" in navigator)) {
            console.warn("[Hub] ServiceWorker not supported in this browser");
            return;
        }

        try {
            await navigator.serviceWorker.register("/sw.js", {
                scope: "/",
            });
            await navigator.serviceWorker.ready;

            navigator.serviceWorker.addEventListener("message", (ev) => {
                handleProxyRequestMessage(ev.data, ev.ports);
            });
            console.log(
                `[Hub] SW registered and listening directly for room '${roomName}'`,
            );
        } catch (err) {
            console.error(
                "[Hub] Failed to initialize Service Worker listener:",
                err,
            );
        }
    }

    initServiceWorkerListener();

    // Fallback for cross-window messaging if needed
    window.addEventListener("message", (ev) => {
        handleProxyRequestMessage(ev.data, ev.ports);
    });
</script>

<style>
    .proxy-page {
        max-width: 980px;
        margin: 0 auto;
        padding: 24px 20px;
        display: flex;
        flex-direction: column;
        gap: 28px;
    }

    /* Header */
    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
    }

    /* Tab Navigation matching room.astro */
    .tab-nav {
        display: flex;
        padding: 4px 0;
        gap: 8px;
        width: fit-content;
    }

    .tab-btn {
        border-radius: 6px;
        font-size: 14px;
        font-weight: 600;
        padding: 0.5rem;
        color: var(--text-secondary);
        background: transparent;
        border: none;
        cursor: pointer;
        transition:
            color 0.15s ease,
            background-color 0.15s ease;
    }

    .tab-btn:hover {
        color: var(--text-primary);
    }

    .tab-btn.active {
        text-decoration: underline;
        color: var(--accent-text);
